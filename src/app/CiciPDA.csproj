<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>   <!-- only for the system-tray NotifyIcon; part of the Windows Desktop runtime, no extra package -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CiciPDA</AssemblyName>
    <RootNamespace>CiciPDA.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>3.0.0</Version>
    <Company>CiciByte Technology, Inc.</Company>
    <Authors>CiciByte Technology, Inc.</Authors>
    <Product>CiciPDA</Product>
    <Copyright>Copyright (c) 2026 CiciByte Technology, Inc.</Copyright>
    <PackageProjectUrl>https://cicibyte.com</PackageProjectUrl>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms share type names (Application, Button, ...): do not import the WinForms namespaces implicitly -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\CiciPDA.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="tools\wintun.dll"><Link>tools\wintun.dll</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="tools\tun2socks.exe"><Link>tools\tun2socks.exe</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="companion\*"><Link>companion\%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="agent.dex"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="..\..\third_party\adb\*"><Link>adb\%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>

  <!-- Fail the build/publish if anything the installed product needs is missing from the real output folder. -->
  <Target Name="ValidateOutputFiles" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_Out Condition="'$(_IsPublishing)' == 'true'">$(PublishDir)</_Out>
      <_Out Condition="'$(_Out)' == ''">$(OutDir)</_Out>
    </PropertyGroup>
    <ItemGroup>
      <_Required Include="$(_Out)CiciPDA.exe;$(_Out)adb\adb.exe;$(_Out)adb\AdbWinApi.dll;$(_Out)adb\AdbWinUsbApi.dll;$(_Out)tools\wintun.dll;$(_Out)tools\tun2socks.exe;$(_Out)agent.dex;$(_Out)companion\cicipda-companion.apk;$(_Out)companion\companion.json;$(_Out)companion\companion.json.sig" />
    </ItemGroup>
    <Error Condition="!Exists('%(_Required.Identity)')" Text="Required runtime file missing from output: %(_Required.Identity)" />
  </Target>
</Project>
